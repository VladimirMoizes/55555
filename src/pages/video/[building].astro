---
import MainLayout from '../../layouts/MainLayout.astro';
import { buildings } from '../../data/mainData';
import SoundButton from '../../components/soundButton/soundButton.astro';

export async function getStaticPaths() {
  return buildings
    .filter((b) => b.videoMp4 || b.videoWebm)
    .map((b) => ({
      params: { building: b.id },
    }));
}

const { building } = Astro.params;

const buildingData = buildings.find((b) => b.id === building);

if (!buildingData) {
  return Astro.redirect('/');
}

const redirectUrl = `/building/${buildingData.id}`;
const directRedirectUrl = buildingData.link;
---

<MainLayout fullHeight={false}>
  <div class="wrapper">
    <div class="sound-wrapper">
      <SoundButton />
    </div>

    <div class="content-wrapper">
      <div class="video-container">
        <video
          id="buildingVideo"
          autoplay
          muted
          playsinline
          class="video"
          onended="console.log('ended сработал через атрибут')"
        >
          {
            buildingData.videoWebm && (
              <source src={buildingData.videoWebm} type="video/webm" />
            )
          }
          {
            buildingData.videoMp4 && (
              <source src={buildingData.videoMp4} type="video/mp4" />
            )
          }
        </video>
      </div>

      {buildingData.mask && <img class="mask" src={buildingData.mask} alt="" />}
    </div>
  </div>
</MainLayout>

<style>
  .wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .sound-wrapper {
    position: absolute;
    right: 20px;
    top: 30px;
    z-index: 10;
  }

  .content-wrapper {
    position: relative;
    width: 100%;
    /* padding-bottom: 150px; */
    display: block;
  }

  .video-container {
    width: 100%;
    height: auto;
    background: black;
    margin: 0;
    padding: 0;
    display: block;
  }

  .video {
    width: 100%;
    height: auto;
    display: block;
    max-height: 100vh;
    object-fit: cover;
  }

  .mask {
    position: absolute;
    bottom: -10vw;
    left: 0;
    height: calc(100% + 150px);
    width: 100%;
    object-fit: contain;
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 1366px) {
    /* .content-wrapper {
      padding-bottom: 100px;
    } */
    .mask {
      height: calc(100% + 100px);
    }
  }

  @media (max-width: 1024px) {
    .sound-wrapper {
      right: 16px;
      top: 20px;
    }
    .content-wrapper {
      margin-block: 60px;
    }
    .mask {
      height: calc(100% + 80px);
    }
  }

  @media (max-width: 768px) {
    .sound-wrapper {
      right: 12px;
      top: 16px;
    }
    .content-wrapper {
      margin-block: 40px;
    }
    .mask {
      height: calc(100% + 60px);
    }
  }

  @media (max-width: 480px) {
    .sound-wrapper {
      right: 8px;
      top: 12px;
    }
    .content-wrapper {
      margin-block: 30px;
    }
    .mask {
      height: calc(100% + 40px);
    }
  }
</style>

<script define:vars={{ redirectUrl, directRedirectUrl, buildingData }}>
  const video = document.getElementById('buildingVideo');
  let redirected = false;
  let videoEnded = false;

  function redirectToBuilding() {
    if (redirected) return;
    redirected = true;
    if (
      buildingData.id === 'park' ||
      buildingData.id === 'garage' ||
      buildingData.id === 'reception'
    ) {
      window.location.replace(directRedirectUrl);
    } else {
      window.location.replace(redirectUrl);
    }
  }

  if (video) {
    video.addEventListener('loadedmetadata', () => {
      if (video.currentTime >= video.duration - 0.1) {
        videoEnded = true;
        redirectToBuilding();
      }
    });

    video.addEventListener('ended', () => {
      if (!videoEnded) {
        videoEnded = true;
        redirectToBuilding();
      }
    });
  }
</script>
