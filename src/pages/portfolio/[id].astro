---
import MainLayout from '../../layouts/MainLayout.astro';
import { roadMapItems } from '../../data/portfolioData';
import styles from './portfolioId.module.css';
import Buttons from '../../components/buttons/Buttons.astro';

export async function getStaticPaths() {
  return roadMapItems.map((item) => ({
    params: { id: String(item.id) },
  }));
}

const { id } = Astro.params;
const item = roadMapItems.find((i) => i.id === Number(id));

if (!item) {
  return Astro.redirect('/portfolio');
}
---

<MainLayout>
  <section class={styles.pageContainer}>
    <div class={styles.description}>
      <h1 class={styles.pageTitle}>{item.name}</h1>
      <p class={styles.text}>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aenean euismod
        bibendum laoreet. Proin gravida dolor sit amet lacus accumsan et viverra
        justo commodo. Proin sodales pulvinar sic tempor. Sociis natoque
        penatibus et magnis dis parturient montes, nascetur ridiculus mus. Nam
        fermentum, nulla luctus pharetra vulputate, felis tellus mollis orci,
        sed rhoncus pronin sapien nunc accuan eget.
      </p>
      <div class={styles.info}>
        <div class={styles.infoTextBlock}>
          <p class={styles.infoText}>HTML5</p>
          <p class={styles.infoText}>2020</p>
        </div>
        <button class={styles.infoButton}>
          <a
            href={item.siteUrl || '#'}
            class={styles.siteLink}
            target="_blank"
            rel="noopener noreferrer">Перейти на сайт</a
          >
        </button>
      </div>
    </div>
    <img class={styles.pageImage} src={item.imageId} alt={item.name} />
    <Buttons />
  </section>
</MainLayout>
