---
import styles from './lift.module.css';
import MainLayout from '../../layouts/MainLayout.astro';
import SoundButton from '../../components/soundButton/soundButton.astro';

const buttonsLift = [
  {
    id: 50,
    ordinary: '/assets/images/lift/lift50.png',
    active: '/assets/images/lift/lift50_light.png',
    content: 'РАЗРАБОТКА САЙТОВ',
  },
  {
    id: 49,
    ordinary: '/assets/images/lift/lift49.png',
    active: '/assets/images/lift/lift49_light.png',
    content: 'МОДЕРНИЗАЦИЯ САЙТОВ',
  },
  {
    id: 48,
    ordinary: '/assets/images/lift/lift48.png',
    active: '/assets/images/lift/lift48_light.png',
    content: 'РЕДИЗАЙН САЙТОВ',
  },
  {
    id: 1,
    ordinary: '/assets/images/lift/lift1.png',
    active: '/assets/images/lift/lift1_light.png',
  },
];
---

<MainLayout>
  <SoundButton class={styles.sound} />
  <section class={styles.container}>
    <h1 class={styles.title}>веб-Разработка</h1>
    <div class={styles.blockLift}>
      <div class={styles.tableLift}>
        <p class={styles.floorCurrentNumber} data-floor></p>
      </div>
      <ul class={styles.buttonsLift}>
        {
          buttonsLift.map((item) => {
            if (item.id !== 1)
              return (
                <li class={styles.listItem}>
                  <button
                    class={styles.button}
                    data-button-id={item.id}
                    data-floor-number={item.id}
                  >
                    <img
                      class={styles.buttonImage}
                      src={item.ordinary}
                      alt={`lift button ${item.id}`}
                      data-default={item.ordinary}
                      data-active-img={item.active}
                    />
                  </button>
                  <span class={styles.inscription}>{item.content}</span>
                </li>
              );
          })
        }
      </ul>
      <button
        class={`${styles.button} ${styles.buttonOne}`}
        data-button-id={buttonsLift[3].id}
        data-active="true"
        data-floor-number={buttonsLift[3].id}
      >
        <img
          class={styles.buttonImage}
          src={buttonsLift[3].ordinary}
          alt="lift button 1"
          data-default={buttonsLift[3].ordinary}
          data-active-img={buttonsLift[3].active}
        />
      </button>
    </div>
  </section>
</MainLayout>

<script src="./lift.ts"></script>
