import MainLayout from '../../layouts/MainLayout.astro';
import styles from './building.module.css';
import Icon from '../../components/icons/Icon.astro';
import { buildings } from '../../data/mainData';
import SoundButton from '../../components/soundButton/soundButton.astro';
import Tags from '../../components/tags/Tags.astro';
import { housesData } from '../../data/buildingPageData.ts';

export async function getStaticPaths() {
  const excludedIds = ['park', 'garage', 'reception', 'board'];

  return buildings
    .filter((b) => !excludedIds.includes(b.id))
    .map((b) => ({
      params: { id: b.id },
    }));
}

const { id } = Astro.params;

const currentHouses = housesData[id as keyof typeof housesData] || [];

const excludedIds = ['park', 'garage', 'reception', 'honorBoard'];
if (excludedIds.includes(id)) {
  const building = buildings.find((b) => b.id === id);
  if (building) {
    return Astro.redirect(building.link);
  }
  return Astro.redirect('/');
}

const building = buildings.find((b) => b.id === id);

if (!building) {
  throw new Error('Building not found');
}
---

<MainLayout>
  {
    id === 'bank' || id === 'kotoTilda' || id === 'university' ? (
      <section class={styles.containerSimple}>
        <div class={styles.titleListSimple}>
          <h1 class={styles.title}>{building.title}</h1>
          <h2 class={styles.subTitle}>{building.subtitle}</h2>
        </div>
        <a
          class={styles.linkBuildingSimple}
          href={building.link}
          data-link
          target={building.link.startsWith('http') ? '_blank' : undefined}
          rel={
            building.link.startsWith('http') ? 'noopener noreferrer' : undefined
          }
        >
          <img
            style={`width: ${building.separatePage?.width}; height: ${building.separatePage?.height};`}
            class={styles.mainBuildingSimple}
            src={building.image}
            alt={building.title}
          />
        </a>
        <p class={styles.descriptionSimple}>{building.description}</p>
      </section>
    ) : (
      <section class={styles.container}>
        <div class={styles.titleList}>
          <h1 class={styles.title}>{building.title}</h1>
          <h2 class={styles.subTitle}>{building.subtitle}</h2>
        </div>
        {id !== 'museum' && (
          <div class={styles.description}>
            <blockquote
              class={`${styles.quote} ${id !== 'cosmoport' ? styles.hooks : ''}`}
            >
              {building.description}
            </blockquote>
            {id !== 'tv-studio' &&
              id !== 'exhibition' &&
              id !== 'cosmoport' && (
                <Icon
                  name="decorativeArrow"
                  color="var(--color-primary)"
                  size={155}
                  className={styles.icon}
                />
              )}
          </div>
        )}
        <div class={styles.mapLayer}>
          <img
            class={styles.car}
            src="/assets/images/main/car_small.png"
            alt="car"
            data-car
          />
          <img
            class={`${styles.road} ${(id === 'exhibition' || id === 'tv-studio') && styles.roadExhibition}`}
            src="/assets/images/road.svg"
            alt=""
          />
          {currentHouses.map((house) => (
            <img
              class={styles.houseImage}
              src={house.src}
              aria-hidden="true"
              alt=""
              style={{
                top: house.position.top + 'px',
                left: house.position.left + 'px',
                width: house.width + 'px',
                height: house.height + 'px',
              }}
            />
          ))}

          {id === 'museum' && (
            <div class={styles.pointerWrapper} data-pointer>
              <img
                src="/assets/images/go/pointer.png"
                class={styles.pointerImage}
                alt="pointer"
              />
              <p class={styles.pointerText}>Мало ярославец</p>
            </div>
          )}
        </div>
        <a
          class={styles.linkBuilding}
          href={building.link}
          data-link
          target={building.link.startsWith('http') ? '_blank' : undefined}
          rel={
            building.link.startsWith('http') ? 'noopener noreferrer' : undefined
          }
        >
          <img
            class={styles.mainBuilding}
            src={building.image}
            alt={building.title}
            data-building
          />
        </a>
      </section>
    )
  }
  <SoundButton class={styles.sound} />
  <Tags class={styles.tags} />
</MainLayout>

<script src="./building.ts"></script>
