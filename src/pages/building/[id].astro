---
import MainLayout from '../../layouts/MainLayout.astro';
import styles from './[id].module.css';
import Icon from '../../components/icons/Icon.astro';
import { buildings } from '../../data/mainData';
import SoundButton from '../../components/soundButton/soundButton.astro';
import Tags from '../../components/tags/Tags.astro';

export async function getStaticPaths() {
  return buildings.map((b) => ({
    params: { id: b.id },
  }));
}

const { id } = Astro.params;

const building = buildings.find((b) => b.id === id);

if (!building) {
  throw new Error('Building not found');
}
---

<MainLayout>
  {
    id === 'bank' ||
    id === 'kotoTilda' ||
    id === 'university' ||
    id === 'park' ? (
      <section class={styles.containerSimple}>
        <div class={styles.titleListSimple}>
          <h1>{building.title}</h1>
          <h2 class={styles.subTitle}>{building.subtitle}</h2>
        </div>
        <a class={styles.linkBuildingSimple}>
          <img
            style={`width: ${building.separatePage?.width}px; height: ${building.separatePage?.height}px;`}
            class={styles.mainBuildingSimple}
            src={building.image}
            alt={building.title}
          />
        </a>
        <p class={styles.descriptionSimple}>{building.description}</p>
      </section>
    ) : (
      <section class={styles.container}>
        <div class={styles.titleList}>
          <h1>{building.title}</h1>
          <h2 class={styles.subTitle}>{building.subtitle}</h2>
        </div>

        <div class={styles.description}>
          <blockquote class={styles.quote}>{building.description}</blockquote>

          <Icon
            name="decorativeArrow"
            color="var(--color-primary)"
            size={155}
            className={styles.icon}
          />
        </div>

        <div class={styles.mapLayer}>
          <img
            class={styles.car}
            src="/assets/images/main/car_small.png"
            alt="car"
            data-car
          />
          <img class={styles.road} src="/assets/images/road.svg" alt="" />
          {id === 'museum' && (
            <div class={styles.pointerWrapper} data-pointer>
              <img
                src="/assets/images/go/pointer.png"
                class={styles.pointerImage}
                alt="pointer"
              />
              <p class={styles.pointerText}>Мало ярославец</p>
            </div>
          )}
        </div>
        <a class={styles.linkBuilding} data-link>
          <img
            class={styles.mainBuilding}
            src={building.image}
            alt={building.title}
            data-building
          />
        </a>
      </section>
    )
  }
  <SoundButton class={styles.sound} />
  <Tags class={styles.tags} />
</MainLayout>

<script>
  function movingCar() {
    if (typeof window === 'undefined') return;

    const car = document.querySelector('[data-car]') as HTMLElement;
    const building = document.querySelector(
      '[class*="mainBuilding"]'
    ) as HTMLElement;

    if (car) {
      setTimeout(() => {
        car.setAttribute('data-moving', 'true');
      }, 100);
    }

    if (building && window.location.pathname.includes('workshop')) {
      const link = document.querySelector('[data-link]');
      link?.setAttribute('href', '/lift');
    }

    if (building && window.location.pathname.includes('exhibition')) {
      building.style.position = 'relative';
      building.style.top = '-30px';
      building.style.left = '30px';
    }

    if (building && window.location.pathname.includes('cosmoport')) {
      building.style.position = 'relative';
      building.style.top = '-10px';
      building.style.left = '20px';
    }
  }

  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      movingCar();
    });

    document.addEventListener('astro:page-load', () => {
      movingCar();
    });
  }
</script>
