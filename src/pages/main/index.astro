---
import MainLayout from '../../layouts/MainLayout.astro';
import styles from './main.module.css';
import { buildings, housesMap } from '../../data/mainData';
import SoundButton from '../../components/soundButton/soundButton.astro';
import Tags from '../../components/tags/Tags.astro';

const lowestPoint = Math.max(
  ...housesMap.map((item) => item.position.top + item.height + 370),
  800
);
---

<MainLayout>
  <div class={styles.container} style={`min-height: ${lowestPoint}px`}>
    <SoundButton class={styles.sound} />

    <div class={styles.desktopContent}>
      <div class={styles.mapWrapper}>
        <img
          class={styles.car}
          data-car
          src="/assets/images/main/car_small.png"
        />
        <img class={styles.map} src="/assets/images/main/map.svg" />
        <div class={styles.containerMapHouses}>
          {
            housesMap.map((item) => (
              <img
                class={styles.houseMap}
                src={item.image}
                style={`top: ${item.position.top}px; left: ${item.position.left}px; width: ${item.width}px; height: ${item.height}px`}
                alt="decorate"
              />
            ))
          }
        </div>
        <div class={styles.containerBuildings}>
          {
            buildings.map((item) => {
              return (
                <div class={styles.buildingWrapper}>
                  <div
                    class={styles.building}
                    style={`top: ${item.position.top}px; left: ${item.position.left}px;`}
                    data-building-id={item.id}
                  >
                    <img
                      class={styles.imageBuilding}
                      src={item.image}
                      alt={item.title}
                      style={`width: ${item.width}px; height: ${item.height}px;`}
                    />
                    <div class={styles.textBlock}>
                      <span class={styles.textBuilding}>{item.title}</span>
                      <span class={styles.textBuilding}>{item.subtitle}</span>
                    </div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
      <img
        class={styles.slash}
        src="/assets/images/slash_3.svg"
        role="presentation"
        alt="slash"
      />
      <img
        class={styles.slash}
        src="/assets/images/slash_4.svg"
        role="presentation"
        alt="slash"
      />
    </div>

    <div class={styles.mobileContent}>
      <div class={styles.mapLayer}>
        <div class={styles.mobileRoadBlock}>
          <img
            class={styles.roadMobile}
            src="/assets/images/main/mobile/road_mobile.svg"
            alt=""
          />
          <img
            class={styles.carMobile}
            src="/assets/images/main/mobile/car_mobile.png"
            alt="car"
            data-car-mobile
          />
        </div>
      </div>
      <div
        class={styles.mobileContainerBuildings}
        data-mobile-buildings-container
      >
        {
          buildings.map((item) => {
            return (
              <div
                class={styles.mobileBuilding}
                style={`top: ${item.position.top}px; left: ${item.position.left}px;`}
                data-mobile-building-id={item.id}
                data-top={item.position.top}
              >
                <img
                  class={styles.mobileImageBuilding}
                  src={item.image}
                  alt={item.title}
                  style={`width: ${item.width}px; height: ${item.height}px;`}
                />
                <div class={styles.mobiletextBlock}>
                  <span class={styles.mobileTextBuilding}>{item.title}</span>
                  <span class={styles.mobileTextBuilding}>{item.subtitle}</span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
  <Tags class={styles.tags} />
</MainLayout>

<script src="./main.ts"></script>
