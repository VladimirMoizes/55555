---
import SoundButton from '../../components/soundButton/soundButton.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import styles from './go.module.css';
---

<MainLayout>
  <SoundButton class={styles.sound} />
  <div class={styles.imageContainer} data-container>
    <img
      src="/assets/images/go/car_big.png"
      alt="Big car"
      class={styles.carImage}
      data-car
    />

    <img
      src="/assets/images/go/houses_go.png"
      alt=""
      class={styles.houses}
      role="presentation"
      aria-hidden="true"
    />

    <img
      src="/assets/images/go/bush_go.png"
      alt=""
      class={styles.bush}
      aria-hidden="true"
    />
    <img
      src="/assets/images/go/bush_go.png"
      alt=""
      class={styles.bush}
      aria-hidden="true"
    />

    <hr class={styles.solidLine} />

    <img
      src="/assets/images/go/line_dashed.svg"
      alt=""
      class={styles.lineImage}
      aria-hidden="true"
    />

    <div class={styles.pointerWrapper} data-pointer>
      <img
        src="/assets/images/go/pointer.png"
        class={styles.pointerImage}
        alt="pointer"
      />
      <p class={styles.pointerText}>CityLove</p>
    </div>

    <img src="/assets/images/go/tree_go.png" class={styles.tree} alt="tree" />
  </div>
</MainLayout>

<script src="./go.ts"></script>
