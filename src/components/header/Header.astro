---
import styles from './Header.module.css';
import Icon from '../icons/Icon.astro';
import Menu from '../menu/Menu.astro';
---

<header class={styles.header}>
  <img
    class={styles.slash}
    src="/assets/images/slash_1.svg"
    role="presentation"
    alt="slash"
  />
  <img
    class={styles.slash}
    src="/assets/images/slash_2.svg"
    role="presentation"
    alt="slash"
  />
  <p class={styles.textLeft}>CityLoveStudio</p>
  <p class={styles.textCenter}>Разработка NEтривиальных сайтов</p>
  <div class={styles.blockRight}>
    <a class={styles.phoneLink} href="tel:+79265210268">+7 926 521 02 68</a>
    <button id="button-menu">
      <Icon name="burger" color="var(--color-text)" />
    </button>
    <Menu />
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', (): void => {
    const buttonMenu = document.querySelector(
      '#button-menu'
    ) as HTMLButtonElement;
    const menu = document.querySelector('#menu') as HTMLDivElement;

    if (buttonMenu && menu) {
      buttonMenu.addEventListener('click', (): void => {
        const currentTransform = menu.style.transform;

        if (
          currentTransform === 'translateX(0px)' ||
          currentTransform === 'translateX(0)'
        ) {
          menu.style.transform = 'translateX(100%)';
        } else {
          menu.style.transform = 'translateX(0px)';
        }
      });

      document.addEventListener('click', (e: MouseEvent): void => {
        if (e.target instanceof Node) {
          if (
            menu.style.transform === 'translateX(0px)' &&
            !menu.contains(e.target) &&
            !buttonMenu.contains(e.target)
          ) {
            menu.style.transform = 'translateX(100%)';
          }
        }
      });
    }
  });
</script>
