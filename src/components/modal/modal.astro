---
import styles from './modal.module.css';
---

<div id="myModal" class={styles.modal} style="display: none;">
  <div class={styles.modalContent}>
    <button id="closeModalBtn" class={styles.closeBtn}>✕</button>
    <div id="modalContent">
      <slot />
    </div>
  </div>

  <script src="./modal.ts"></script>
</div>
