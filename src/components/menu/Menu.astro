---
import Icon from '../icons/Icon.astro';
import styles from './Menu.module.css';
import { menu } from '../../data/menuData.ts';
const currentPath = Astro.url.pathname;
---

<div class={styles.menu} id="menu">
  <Icon
    name="cross"
    color="var(--color-text)"
    size={32}
    className={styles.icon}
    data-close="true"
  />

  <nav class={styles.nav}>
    <ul class={styles.navMenu}>
      {
        menu.map((item) => (
          <li
            class={styles.menuItem}
            data-active={
              (item.url && currentPath === item.url) ||
              (item.id === 2 &&
                (currentPath === '/lift' || currentPath === '/lift/')) ||
              (item.subMenu && currentPath.startsWith('/websites/'))
            }
            data-open="false"
          >
            <a
              href={item.url}
              target={item.url?.startsWith('http') ? '_blank' : undefined}
              rel={
                item.url?.startsWith('http') ? 'noopener noreferrer' : undefined
              }
            >
              {item.name}
            </a>

            {item.subMenu && item.subMenu.length > 0 && (
              <>
                <img
                  src="/assets/images/menu/menu_arrow.svg"
                  alt=""
                  aria-hidden="true"
                  class={styles.arrow}
                  data-arrow
                />

                <ul class={styles.subMenu} data-submenu>
                  {item.subMenu.map((subItem) => (
                    <li
                      class={styles.subMenuItem}
                      data-active={currentPath === subItem.url}
                    >
                      <a
                        href={subItem.url}
                        target={
                          subItem.url.startsWith('http') ? '_blank' : undefined
                        }
                        rel={
                          subItem.url.startsWith('http')
                            ? 'noopener noreferrer'
                            : undefined
                        }
                      >
                        {subItem.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <div class={styles.buttonListMessenger}>
    <!-- <button
      class={styles.button}
      aria-label="Открыть whatsapp"
      data-link-icon="https://wa.me/79691969595?text=Здравствуйте!%20Хочу%20заказать%20сайт"
    >
      <Icon name="whatsapp" color="var(--color-primary)" />
    </button> -->
    <button
      class={`${styles.button} ${styles.buttonNumber}`}
      aria-label="Позвонить"
    >
      <a class={styles.buttonNumberLink} href="tel:+79265210268"> +7 926 521 02 68 </a>
    </button>
    <button
      class={styles.button}
      aria-label="Telegram"
      data-link-icon="https://t.me/fatboy200?text=Здравствуйте!%20Интересует%20разработка%20сайта."
    >
      <Icon name="telegram" color="var(--color-primary)" />
    </button>
    <button
      class={styles.button}
      aria-label="Max"
      data-link-icon="https://web.max.ru/"
    >
      <Icon name="max" color="var(--color-primary)" />
    </button>
  </div>
</div>

<script src="./menu.ts"></script>
