---
import Icon from '../icons/Icon.astro';
import styles from './Menu.module.css';
import { menu } from '../../data/menuData.ts';
const currentPath = Astro.url.pathname;
---

<div class={styles.menu} id="menu">
  <Icon
    name="cross"
    color="var(--color-text)"
    size={32}
    className={styles.icon}
    data-close="true"
  />

  <nav class={styles.nav}>
    <ul class={styles.navMenu}>
      {
        menu.map((item) => (
          <li
            class={styles.menuItem}
            data-active={
              currentPath === item.url ||
              (item.subMenu && currentPath.startsWith('/websites/'))
            }
            data-open="false"
          >
            <a href={item.url}>{item.name}</a>

            {item.subMenu && item.subMenu.length > 0 && (
              <>
                <img
                  src="/assets/images/menu/menu_arrow.svg"
                  alt=""
                  aria-hidden="true"
                  class={styles.arrow}
                  data-arrow
                />

                <ul class={styles.subMenu} data-submenu>
                  {item.subMenu.map((subItem) => (
                    <li
                      class={styles.subMenuItem}
                      data-active={currentPath === subItem.url}
                    >
                      <a href={subItem.url}>{subItem.name}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <div class={styles.buttonListMessenger}>
    <button class={styles.button} aria-label="Telegram">
      <Icon name="telegram" color="var(--color-primary)" />
    </button>
    <button class={styles.button} aria-label="Max">
      <Icon name="max" color="var(--color-primary)" />
    </button>
  </div>
</div>

<script src="./menu.ts"></script>
