---
import Icon from '../icons/Icon.astro';

const { class: className = '' } = Astro.props;
---

<div
  transition:persist
  class={`sound-button ${className}`}
  data-sound
  style="view-transition-name: sound-button;"
>
  <div data-icon-on>
    <Icon name="soundOn" size={26} />
  </div>
  <div data-icon-off style="display: none;">
    <Icon name="soundOff" size={26} />
  </div>
</div>

<style>
  .sound-button {
    border: 1px solid var(--color-text);
    padding: 12px 14px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 0;
    color: var(--color-primary);
    view-transition-name: sound-button;
  }

  .sound-button svg {
    transition: color 0.2s ease;
  }

  .sound-button:hover svg {
    color: white;
  }
</style>

<script>
  let audio: HTMLAudioElement | null = null;
  let isSoundOn = localStorage.getItem('soundState') !== 'false';

  function initAudio() {
    if (!audio) {
      audio = new Audio('/assets/audio/music.mp3');
      audio.loop = true;
      audio.volume = 0.5;

      if (isSoundOn) {
        audio.play().catch(() => {});
      }
    }
  }

  function toggleAudio() {
    if (!audio) return;

    if (isSoundOn) {
      audio.play().catch(() => {});
    } else {
      audio.pause();
    }
  }

  function updateSoundButton() {
    const button = document.querySelector('[data-sound]');
    if (!button) return;

    const iconOn = button.querySelector('[data-icon-on]') as HTMLElement;
    const iconOff = button.querySelector('[data-icon-off]') as HTMLElement;

    if (isSoundOn) {
      iconOn.style.display = 'flex';
      iconOff.style.display = 'none';
    } else {
      iconOn.style.display = 'none';
      iconOff.style.display = 'flex';
    }
  }

  function init() {
    initAudio();
    updateSoundButton();

    document.body.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const button = target.closest('[data-sound]');
      if (button) {
        isSoundOn = !isSoundOn;
        localStorage.setItem('soundState', String(isSoundOn));
        toggleAudio();
        updateSoundButton();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('astro:after-swap', () => {
    isSoundOn = localStorage.getItem('soundState') !== 'false';
    updateSoundButton();

    if (audio && isSoundOn && audio.paused) {
      audio.play().catch(() => {});
    }
  });
</script>
