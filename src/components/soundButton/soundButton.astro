---
import Icon from '../icons/Icon.astro';
import { getSoundState, toggleAudio } from '../header/header';

const { class: className = '' } = Astro.props;
const isSoundOn = getSoundState();
---

<div
  transition:persist
  class={`sound-button ${className}`}
  data-sound
  style="view-transition-name: sound-button;"
>
  <div data-icon-on>
    <Icon name="soundOn" size={20} />
  </div>
  <div data-icon-off style="display: none;">
    <Icon name="soundOff" size={20} />
  </div>
  <span class="textSoundButton">включить</span>
</div>

<style>
  .sound-button {
    border: 1px solid var(--color-text);
    padding: 10px 12px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 0;
    color: var(--color-primary);
    view-transition-name: sound-button;
    gap: 10px;
  }

  .sound-button svg,
  .sound-button .textSoundButton {
    transition: color 0.2s ease;
  }

  .sound-button:hover svg,
  .sound-button:hover .textSoundButton {
    color: var(--color-text);
  }
</style>

<script>
  import { toggleAudio, getSoundState } from '../header/header';

  function updateSoundButton() {
    const button = document.querySelector('[data-sound]');
    if (!button) return;

    const iconOn = button.querySelector('[data-icon-on]') as HTMLElement;
    const iconOff = button.querySelector('[data-icon-off]') as HTMLElement;
    const isSoundOn = getSoundState();
    const textSound = button.querySelector('.textSoundButton') as HTMLElement;

    if (isSoundOn) {
      iconOn.style.display = 'flex';
      iconOff.style.display = 'none';
      textSound.textContent = 'выключить';
    } else {
      iconOn.style.display = 'none';
      iconOff.style.display = 'flex';
      textSound.textContent = 'включить';
    }
  }

  document.body.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const button = target.closest('[data-sound]');
    if (button) {
      toggleAudio();
      updateSoundButton();
    }
  });

  updateSoundButton();
</script>
