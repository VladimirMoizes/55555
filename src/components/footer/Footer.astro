---
import styles from './Footer.module.css';
import Icon from '../icons/Icon.astro';
---

<footer class={styles.footer}>
  <!-- <img
    class={styles.slash}
    src="/assets/images/slash_3.svg"
    role="presentation"
    alt="slash"
  />
  <img
    class={styles.slash}
    src="/assets/images/slash_4.svg"
    role="presentation"
    alt="slash"
  /> -->
  <div class={styles.main}>
    <div class={styles.blockLeft}>
      <p class={styles.blockLeftName}>CityLoveStudio</p>
      <p class={styles.blockLeftOldName}>ранее Битмодерн</p>
    </div>
    <div class={styles.contacts}>
      <a href="tel:+79265210268" class={styles.phone}>
        <Icon name="phone" color="var(--color-primary)" />
        <span>+7 926 521 02 68</span>
      </a>
      <a href="mailto:sizubin@bitmodern.ru" class={styles.email}>
        <Icon name="email" color="var(--color-primary)" />
        <span>sizubin@bitmodern.ru</span>
      </a>
      <a
        href="https://maps.yandex.ru/?text=Москва, ул. Ак. Арцимовича д.3 кор.2"
        class={styles.address}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="location" color="var(--color-primary)" />
        <span>Москва, ул. Ак. Арцимовича д.3 кор.2</span>
      </a>
    </div>
    <div class={styles.buttonListMessenger}>
      <button
        class={styles.button}
        aria-label="Открыть whatsapp"
        data-link-icon="https://wa.me/79691969595?text=Здравствуйте!%20Хочу%20заказать%20сайт"
      >
        <Icon name="whatsapp" color="var(--color-primary)" />
      </button>
      <button
        class={styles.button}
        aria-label="Открыть Telegram"
        data-link-icon="https://t.me/fatboy200?text=Здравствуйте!%20Интересует%20разработка%20сайта."
      >
        <Icon name="telegram" color="var(--color-primary)" />
      </button>
      <button
        class={styles.button}
        aria-label="Открыть max"
        data-link-icon="https://web.max.ru/"
      >
        <Icon name="max" color="var(--color-primary)" />
      </button>
    </div>
  </div>
  <div class={styles.bottom}>
    <p class={styles.bottomStart}>2016-2025 Все права защищены</p>
    <a>Политика конфиденциальности</a>
  </div>
</footer>

<script>
  function initSocialButtons(): void {
    document.querySelectorAll('[data-link-icon]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const link = btn.getAttribute('data-link-icon');
        if (link) {
          window.open(link, '_blank');
        }
      });
    });
  }

  if (typeof document !== 'undefined') {
    document.addEventListener('DOMContentLoaded', (): void => {
      initSocialButtons();
    });
    document.addEventListener('astro:page-load', (): void => {
      initSocialButtons();
    });
  }
</script>
